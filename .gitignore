# ==========================================
# 1. PYTHON BYTECODE & CACHE
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# 2. VIRTUAL ENVIRONMENTS
# ==========================================
# Ignore all virtual environment folders
venv/
ENV/
env/
.venv

# ==========================================
# 3. IDE & EDITOR CONFIGURATIONS
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ==========================================
# 4. TESTING, COVERAGE & LINTING
# ==========================================
# Pytest
.pytest_cache/
.tox/
.nox/

# Coverage reports
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Mypy / Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff / Flake8 / Pylint
.ruff_cache/
.pylintrc
.flake8

# ==========================================
# 5. MACHINE LEARNING & AI MODELS (CRITICAL)
# ==========================================
# SocialAgent uses NLP and Image hashing. 
# NEVER commit downloaded models or heavy datasets to Git.
models/
checkpoints/
*.bin
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.joblib
datasets/
cache/huggingface/
cache/torch/

# ==========================================
# 6. SECRETS, API KEYS & ENV VARIABLES
# ==========================================
# NEVER commit API keys for social media scrapers or databases
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json
config.yaml # If it contains hardcoded passwords (use config.example.yaml instead)

# ==========================================
# 7. LOGS & TEMPORARY FILES
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
tmp/
temp/

# ==========================================
# 8. DATABASE & CACHING (Redis/SQLite)
# ==========================================
# Ignore local database files used for caching impersonation reports
*.sqlite
*.sqlite3
*.db
dump.rdb # Redis

# ==========================================
# 9. OS GENERATED FILES
# ==========================================
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
